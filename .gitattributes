# CMD parses .bat by byte offset and assumes CRLF. With LF-only line endings
# GOTO/CALL jumps land on the wrong line, so the checkout must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF so they work when sourced on Linux/macOS.
*.sh  text eol=lf
setadb text eol=lf
